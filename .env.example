# AI Career Intelligence & Resume Analyzer Environment Configuration

# -----------------------------------------------------------------------------
# Optional: Google Gemini API Key
# -----------------------------------------------------------------------------
# Enables optional LLM-assisted conversational coaching and summary rewrites.
# If omitted or unavailable, the application automatically runs in 100% offline,
# zero-cost, deterministic Local Analysis Engine mode.
# Supports either GEMINI_API_KEY or GOOGLE_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# Application URL Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Multi-Platform Messaging Bot Integrations (Optional)
# -----------------------------------------------------------------------------
# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=CareerCopilotBot

# Discord Bot Webhook
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Chat Incoming Webhook
GOOGLE_CHAT_WEBHOOK_URL=your_google_chat_webhook_url_here

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=career_intelligence_secret
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=15551234567
